<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Coflnet.Sky.Indexer.Tools.ArchiveNasVerify</RootNamespace>
    <GenerateProgramFile>false</GenerateProgramFile>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>
    <!-- same shared core library SkyIndexer uses (codec, ArchivedAuctionBlock, ArchivedTagIndex) -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../dev/hypixel.csproj" />
  </ItemGroup>

</Project>
